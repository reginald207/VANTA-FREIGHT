{
  "name": "vanta-freight",
  "private": true,
  "version": "0.1.0",
  "description": "VANTA FREIGHT: a fictional, cinematic transport and cargo website (design and engineering showcase).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "posters": "node scripts/render-posters.mjs",
    "pretest:smoke": "vite build",
    "test": "node --test tests/choreography.test.mjs tests/tracking.test.mjs tests/seo.test.mjs tests/model.test.mjs",
    "test:smoke": "node --test --test-concurrency=1 tests/*.test.mjs",
    "preaudit:lighthouse": "vite build",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "lighthouse": "13.6.0",
    "ndarray-pixels": "5.2.0",
    "playwright": "1.63.0",
    "vite": "8.3.5"
  }
}
